{
  "bbox": [19.0, -14.0, 54.0, 26.0],
  "data_dir": "data",
  "period": {
    "start": "1981-01",
    "end": "latest"
  },
  "calibration": {
    "start_year": 1991,
    "end_year": 2020
  },
  "download": {
    "workers": 8,
    "retries": 4,
    "timeout": 120
  },
  "sources": {
    "chirps_v3": {
      "enabled": true,
      "urls": [
        "https://data.chc.ucsb.edu/products/CHIRPS/v3.0/monthly/africa/tifs/chirps-v3.0.{year}.{month:02d}.tif",
        "https://data.chc.ucsb.edu/products/CHIRPS/v3.0/monthly/africa/tifs/chirps-v3.0.{year}.{month:02d}.tif.gz"
      ],
      "first_month": "1981-01"
    },
    "chirps_v2": {
      "enabled": true,
      "urls": [
        "https://data.chc.ucsb.edu/products/CHIRPS-2.0/africa_monthly/tifs/chirps-v2.0.{year}.{month:02d}.tif.gz",
        "https://data.chc.ucsb.edu/products/CHIRPS-2.0/africa_monthly/tifs/chirps-v2.0.{year}.{month:02d}.tif"
      ],
      "first_month": "1981-01"
    },
    "arc2": {
      "enabled": true,
      "url": "https://ftp.cpc.ncep.noaa.gov/fews/fewsdata/africa/arc2/geotiff/africa_arc.{date:%Y%m%d}.tif.zip",
      "zip_members": ["daily_clim.{date:%Y%m%d}.tif"],
      "first_month": "1983-01",
      "max_missing_days": 0
    },
    "rfe2": {
      "enabled": true,
      "url": "https://ftp.cpc.ncep.noaa.gov/fews/fewsdata/africa/rfe2/geotiff/africa_rfe.{date:%Y%m%d}.tif.zip",
      "first_month": "2001-01",
      "max_missing_days": 0,
      "calibration": {
        "start_year": 2001,
        "end_year": 2020
      }
    }
  },
  "pet": {
    "method": "cru_penman_monteith"
  },
  "temperature": {
    "source": "cru"
  },
  "cru": {
    "version": "4.10",
    "base_url": "https://crudata.uea.ac.uk/cru/data/hrg/cru_ts_4.10/cruts.2604091129.v4.10"
  },
  "soil": {
    "source": "soilgrids",
    "wcs_url": "https://maps.isric.org/mapserv?map=/map/{property}.map",
    "layers": ["0-5cm", "5-15cm", "15-30cm", "30-60cm", "60-100cm"],
    "resolution": 0.025,
    "aggregate": 2,
    "fallback_mm": 100.0
  },
  "indices": {
    "scales": [1, 3, 6, 9, 12, 24, 48],
    "distributions": {
      "spi": ["gamma", "pearson3"],
      "spei": ["pearson3", "gamma", "loglogistic"]
    },
    "palmer": true,
    "clip": 3.09
  },
  "engines": {
    "climate_indices": {
      "enabled": true,
      "workers": 0,
      "scpdsi": true
    },
    "xclim_app": {
      "enabled": true,
      "method": "APP"
    },
    "xclim_pwm": {
      "enabled": true,
      "method": "PWM"
    }
  },
  "compute": {
    "chunk": 100,
    "coarsen": 1
  }
}
