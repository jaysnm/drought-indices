# Copy to .env and adjust. Every setting is optional.

# Container user, "uid:gid". With rootful Docker, use the host user (`id -u`:`id -g`) so
# that it owns the files written to the data directory. With rootless Docker or Podman,
# container root already maps to the host user, so use 0:0 (any other uid cannot write).
CONTAINER_USER=1000:1000

# Host paths mounted into the containers
DATA_DIR=./data
CONFIG_FILE=./config/config.json

# Image name, e.g. a registry path
DROUGHT_INDICES_IMAGE=drought-indices:latest

# Hours between scheduled updates (scheduler service)
UPDATE_INTERVAL_HOURS=24

# ERA5-Land temperature (temperature.source: "era5_land"): build with the era5 extra and
# give the Copernicus CDS credentials
# UV_EXTRAS=--extra era5
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=<your-personal-access-token>
